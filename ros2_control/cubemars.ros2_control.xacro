                                     invert:=False">
    <xacro:cubemars_ak 
      name="${name}" 
      prefix="${prefix}" 
      can_id="${can_id}" 
      kp="${kp}" 
      kd="${kd}" 
      pos_min="-95.5" 
      pos_max="95.5"
      vel_min="-45.0" 
      vel_max="45.0" 
      effort_min="-18.0" 
      effort_max="18.0"
      invert="${invert}"
    />
  </xacro:macro>

  <xacro:macro name="AK80-6_V2" params="name 
