<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="cubemars_ak" params="name 
                                          prefix 
                                          can_id 
                                          kp kd 
                                          vel_min vel_max 
                                          effort_min effort_max 
                                          pos_min:=-12.5 pos_max:=12.5 
                                          kp_min:=0 kp_max:=500 
                                          kd_min:=0 kd_max:=5 
                                          invert:=False">
    <joint name="${prefix}${name}">
      <param name="can_id">${can_id}</param>
      <param name="kp">${kp}</param>
      <param name="kd">${kd}</param>
      <param name="kp_min">${kp_min}</param>
      <param name="kp_max">${kp_max}</param>
      <param name="kd_min">${kd_min}</param>
      <param name="kd_max">${kd_max}</param>
      <param name="pos_min">${pos_min}</param>
      <param name="pos_max">${pos_max}</param>
      <param name="vel_min">${vel_min}</param>
      <param name="vel_max">${vel_max}</param>
      <param name="effort_min">${effort_min}</param>
      <param name="effort_max">${effort_max}</param>
      <param name="invert">${invert}</param>

      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <command_interface name="proportional">
        <param name="initial_value">${kp}</param>
      </command_interface>
      <command_interface name="derivative">
        <param name="initial_value">${kp}</param>
      </command_interface>

      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="temperature"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="AK10-9" params="name 
                                     prefix 
                                     can_id 
                                     kp kd 
                                     invert:=False">
    <xacro:cubemars_ak 
      name="${name}" 
      prefix="${prefix}" 
      can_id="${can_id}" 
      kp="${kp}" 
      kd="${kd}" 
      vel_min="-50.0" 
      vel_max="50.0" 
      effort_min="-65.0" 
      effort_max="65.0"
      invert="${invert}"
    /> 
  </xacro:macro>

  <xacro:macro name="AK60-6" params="name 
                                     prefix 
                                     can_id 
                                     kp kd 
                                     invert:=False">
    <xacro:cubemars_ak 
      name="${name}" 
      prefix="${prefix}" 
      can_id="${can_id}" 
      kp="${kp}" 
      kd="${kd}" 
      vel_min="-45.0" 
      vel_max="45.0" 
      effort_min="-15.0" 
      effort_max="15.0"
      invert="${invert}"

    /> 
  </xacro:macro>

